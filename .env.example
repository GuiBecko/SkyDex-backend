# Copy to .env and adjust. Only needed when running this service on its own;
# under `docker compose up` from the umbrella repository, values come from
# compose instead.

# --- Database -----------------------------------------------------------
URL_POSTGRES=jdbc:postgresql://localhost:5432/skydex
USUARIO_POSTGRES=postgres
SENHA_POSTGRES=postgres

# --- Auth ---------------------------------------------------------------
# CHANGE THIS. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_JWT_SECRET=change-me-before-running-anything-real

# --- Server -------------------------------------------------------------
SERVER_PORT=3002

# --- Photo storage ------------------------------------------------------
PHOTO_STORAGE_DIR=./data/photos
PUBLIC_BASE_URL=http://localhost:3002

# --- Vision service -----------------------------------------------------
# Reachable on the host when skydex-vision runs from its own docker-compose.
VISION_BASE_URL=http://localhost:8000
VISION_OUTDOOR_MIN=0.60
VISION_EXPECTED_SCORE_MAX=0.10
VISION_TOP_SCORE_MIN=0.70
